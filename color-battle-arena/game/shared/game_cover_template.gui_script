-- shared/game_cover_template.gui_script
-- Reusable cover/intro screen for new Defold games.
--
-- Each new game copies this file + game_cover_template.gui, then customises
-- the CONFIG table below and the howto image references inside the .gui.

local game_progress = require("shared.game_progress")

-- ============================================================
-- CONFIG — edit these in each game's copy
-- ============================================================
local CONFIG = {
    game_key = "template",
    title = "GAME TITLE",
    description = "Short description of how the game plays. This text wraps over multiple lines within the description node.",
    howto_pages = {
        { image = "game_cover/white_placeholder", text = "Step 1: tap to start." },
        { image = "game_cover/white_placeholder", text = "Step 2: drag to move." },
        { image = "game_cover/white_placeholder", text = "Step 3: clear to win." },
    },
    -- Message url to post "start_game" to when PLAY is tapped.
    -- Typical value: "#gameplay" (a script component in the same collection).
    game_url = "#gameplay",
}

-- ============================================================
-- Difficulty slider
-- ============================================================
local DIFFICULTIES = { "easy", "medium", "hard" }
local DIFFICULTY_LABELS = { easy = "EASY", medium = "MEDIUM", hard = "HARD" }
local DIFFICULTY_EMOJI = {
    easy = "white_placeholder",
    medium = "white_placeholder",
    hard = "white_placeholder",
}

-- Slider track geometry (relative to slider_track node).
-- Track is 720 wide in the .gui, knob is 70 wide, so flush endpoints sit at
-- ±(360 - 35) = ±325.
local SLIDER_HALF_WIDTH = 325
local SLIDER_X_POSITIONS = { -SLIDER_HALF_WIDTH, 0, SLIDER_HALF_WIDTH }

local state = {
    difficulty_index = 2,
    howto_page = 1,
    howto_open = false,
    settings_open = false,
    dragging_slider = false,
    drag_press_x = 0,        -- screen x at the moment of press
    drag_start_knob_x = 0,   -- knob's local-to-track x at the moment of press
}

-- ============================================================
-- Helpers
-- ============================================================
local function current_difficulty()
    return DIFFICULTIES[state.difficulty_index]
end

local function update_difficulty_display()
    local d = current_difficulty()
    gui.set_text(gui.get_node("difficulty_label"), DIFFICULTY_LABELS[d])
    -- Update emoji texture (will no-op if texture id not in atlas)
    local emoji = gui.get_node("difficulty_face")
    pcall(gui.play_flipbook, emoji, hash(DIFFICULTY_EMOJI[d]))
    -- Snap knob to slot
    local knob = gui.get_node("slider_knob")
    local pos = gui.get_position(knob)
    pos.x = SLIDER_X_POSITIONS[state.difficulty_index]
    gui.set_position(knob, pos)
end

local function update_play_label()
    local level = game_progress.get_level(CONFIG.game_key)
    local label_node = gui.get_node("play_level_text")
    if level > 1 then
        gui.set_enabled(label_node, true)
        gui.set_text(label_node, "Level " .. level)
    else
        -- Hide the "Level 1" line for a fresh player; PLAY sits alone centered.
        gui.set_enabled(label_node, false)
    end
end

local function show_toast(text)
    local node = gui.get_node("toast_text")
    gui.set_text(node, text)
    gui.set_color(node, vmath.vector4(0.2, 0.2, 0.2, 0))
    gui.animate(node, "color.w", 1, gui.EASING_INOUTQUAD, 0.2, 0, function()
        gui.animate(node, "color.w", 0, gui.EASING_INOUTQUAD, 0.4, 1.2)
    end)
end

-- ============================================================
-- Howto modal
-- ============================================================
local function render_howto_page()
    local page = CONFIG.howto_pages[state.howto_page]
    if not page then return end
    -- 配图未就绪（白占位）时隐藏图片区、文字上移到图片位置，避免大白块
    local img = gui.get_node("howto_image")
    local txt = gui.get_node("howto_text")
    if not state.howto_text_y0 then state.howto_text_y0 = gui.get_position(txt).y end
    local has_image = page.image and page.image ~= "game_cover/white_placeholder"
    gui.set_enabled(img, has_image)
    local tp = gui.get_position(txt)
    tp.y = has_image and state.howto_text_y0 or gui.get_position(img).y
    gui.set_position(txt, tp)
    if has_image then pcall(gui.set_texture, img, page.image) end
    gui.set_text(txt, page.text or "")
    -- Update page dots (up to 5 dots reserved in template)
    for i = 1, 5 do
        local dot = gui.get_node("page_dot_" .. i)
        if dot then
            if i > #CONFIG.howto_pages then
                gui.set_enabled(dot, false)
            else
                gui.set_enabled(dot, true)
                local a = (i == state.howto_page) and 1.0 or 0.35
                gui.set_color(dot, vmath.vector4(0.4, 0.3, 0.6, a))
            end
        end
    end
end

local function open_howto()
    state.howto_open = true
    state.howto_page = 1
    gui.set_enabled(gui.get_node("howto_modal"), true)
    render_howto_page()
end

local function close_howto()
    state.howto_open = false
    gui.set_enabled(gui.get_node("howto_modal"), false)
end

local function howto_prev()
    if state.howto_page > 1 then
        state.howto_page = state.howto_page - 1
        render_howto_page()
    end
end

local function howto_next()
    if state.howto_page < #CONFIG.howto_pages then
        state.howto_page = state.howto_page + 1
        render_howto_page()
    end
end

-- ============================================================
-- Settings modal
-- ============================================================
local function open_settings()
    state.settings_open = true
    gui.set_enabled(gui.get_node("settings_modal"), true)
end

local function close_settings()
    state.settings_open = false
    gui.set_enabled(gui.get_node("settings_modal"), false)
end

local function delete_progress()
    game_progress.reset(CONFIG.game_key)
    state.difficulty_index = 2
    update_difficulty_display()
    update_play_label()
    close_settings()
    show_toast("Progress cleared!")
end

-- ============================================================
-- Slider interaction
-- ============================================================
local function slider_index_from_x(local_x)
    local best_i, best_dist = 1, math.huge
    for i, sx in ipairs(SLIDER_X_POSITIONS) do
        local d = math.abs(sx - local_x)
        if d < best_dist then
            best_dist = d
            best_i = i
        end
    end
    return best_i
end

-- ============================================================
-- Defold lifecycle
-- ============================================================
function init(self)
    msg.post(".", "acquire_input_focus")
    -- 独立/web 包没有大厅：隐藏并禁用 BACK TO HOME
    state.is_standalone = sys.get_config_string("playdoz.mode", "collection") == "standalone"
    gui.set_enabled(gui.get_node("btn_back"), not state.is_standalone)

    -- Load saved state
    state.difficulty_index = 2
    local saved = game_progress.get_difficulty(CONFIG.game_key)
    for i, d in ipairs(DIFFICULTIES) do
        if d == saved then state.difficulty_index = i end
    end

    -- Title / description
    gui.set_text(gui.get_node("title_text"), CONFIG.title)
    gui.set_text(gui.get_node("description_text"), CONFIG.description)

    -- Initial UI state
    gui.set_enabled(gui.get_node("howto_modal"), false)
    gui.set_enabled(gui.get_node("settings_modal"), false)
    gui.set_color(gui.get_node("toast_text"), vmath.vector4(0.2, 0.2, 0.2, 0))

    update_difficulty_display()
    update_play_label()
end

function on_message(self, message_id, message, sender)
    if message_id == hash("hide") then
        gui.set_enabled(gui.get_node("root"), false)
    elseif message_id == hash("show") then
        gui.set_enabled(gui.get_node("root"), true)
        update_play_label()
    end
end

function on_input(self, action_id, action)
    -- Ignore input when hidden.
    if not gui.is_enabled(gui.get_node("root")) then return false end

    -- Allow nil action_id through while dragging the slider (Defold delivers
    -- move events with nil action_id between press and release).
    if action_id ~= hash("touch") and not (state.dragging_slider and action_id == nil) then
        return false
    end

    -- Modal interactions take priority
    if state.howto_open then
        if action.released then
            if gui.pick_node(gui.get_node("btn_prev"), action.x, action.y) then
                howto_prev() ; return true
            elseif gui.pick_node(gui.get_node("btn_next"), action.x, action.y) then
                howto_next() ; return true
            elseif gui.pick_node(gui.get_node("btn_ok"), action.x, action.y) then
                close_howto() ; return true
            end
        end
        return true -- swallow taps outside buttons while modal is open
    end

    if state.settings_open then
        if action.released then
            if gui.pick_node(gui.get_node("btn_reset"), action.x, action.y) then
                delete_progress() ; return true
            elseif gui.pick_node(gui.get_node("btn_close_settings"), action.x, action.y) then
                close_settings() ; return true
            end
        end
        return true
    end

    -- Slider drag — use delta from press point. On press we record where the
    -- cursor is and where the knob was; while dragging, the knob follows the
    -- cursor by the same delta so the initial grab point stays under the
    -- finger and the knob does not move unless the finger does.
    local knob = gui.get_node("slider_knob")
    if action.pressed and gui.pick_node(knob, action.x, action.y) then
        state.dragging_slider = true
        state.drag_press_x = action.x
        state.drag_start_knob_x = gui.get_position(knob).x
        return true
    end
    if state.dragging_slider then
        local target_x = state.drag_start_knob_x + (action.x - state.drag_press_x)
        if target_x < SLIDER_X_POSITIONS[1] then target_x = SLIDER_X_POSITIONS[1] end
        if target_x > SLIDER_X_POSITIONS[#SLIDER_X_POSITIONS] then
            target_x = SLIDER_X_POSITIONS[#SLIDER_X_POSITIONS]
        end
        local kpos = gui.get_position(knob)
        kpos.x = target_x
        gui.set_position(knob, kpos)
        if action.released then
            state.dragging_slider = false
            state.difficulty_index = slider_index_from_x(target_x)
            update_difficulty_display()
            game_progress.set_difficulty(CONFIG.game_key, current_difficulty())
        end
        return true
    end

    if not action.released then return false end

    -- Button taps
    if not state.is_standalone and gui.pick_node(gui.get_node("btn_back"), action.x, action.y) then
        msg.post("main:/main#script", "unload_game")
        return true
    elseif gui.pick_node(gui.get_node("btn_settings"), action.x, action.y) then
        open_settings()
        return true
    elseif gui.pick_node(gui.get_node("btn_howto"), action.x, action.y) then
        open_howto()
        return true
    elseif gui.pick_node(gui.get_node("btn_play"), action.x, action.y) then
        game_progress.set_difficulty(CONFIG.game_key, current_difficulty())
        msg.post(CONFIG.game_url, "start_game", {
            level = game_progress.get_level(CONFIG.game_key),
            difficulty = current_difficulty(),
        })
        return true
    end

    return false
end

function final(self)
    msg.post(".", "release_input_focus")
end
