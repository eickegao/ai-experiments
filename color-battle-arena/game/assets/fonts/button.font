font: "/assets/fonts/PlayDozUI.ttf"
material: "/builtins/fonts/font.material"
size: 48
antialias: 1
alpha: 1.0
outline_alpha: 1.0
outline_width: 2.0
shadow_alpha: 1.0
shadow_blur: 0
shadow_x: 0.0
shadow_y: -4.0
extra_characters: ""
output_format: TYPE_BITMAP
all_chars: false
cache_width: 512
cache_height: 512
render_mode: MODE_MULTI_LAYER
