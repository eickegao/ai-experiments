-- games/clashdoz/clashdoz_prep.gui_script
-- CLASHDOZ 准备页 = 技能卡收藏页（用户 2026-11-04 给图改版：不再给玩家看对手有几张牌、靠暗中堆对手的技能卡来加难度）。每关（和 1 VS 1 / 1 VS 8 试玩）开局前经过这页——
--   顶栏：BACK / 金币 / 技能点（框内绿 + 号：有币直接扣 100 买 1 点，用户 2026-11-04 晚：不要二次确认）；
--   "Collection n / N" 进度条（用户 2026-11-04 晚六改：上提、删掉 "Skill Points: Unlock…" 那一行、卡牌整体上移）；
--   卡牌网格（3 列 × 2 行一页，左右滑页 + 页点）：每种技能一张——点亮的卡：球图 + 名字 + Lv.n + 绿钮 Upgrade ⚡1（满级灰 MAX）；没点亮的：灰卡 + 锁 + 蓝钮 Unlock ⚡1。
--   点卡面 = 带 / 不带进场（绿框 + 勾；最多 cd_profile.slots 张）；卡牌底下三个"坑" = 带进场的卡（空坑深色、第 3 坑锁 + 500 金币开，点带着的坑取下）；
--   最底 START（没选够 min(2, 点亮数) 张不让开） → controller "prep_start"{ level|layout, loadout, enemies, eager }。
--   对手的技能仍由 cd_levels.roll 按关卡随机发，但这页不显示。
-- 升级规则（cd_config.SKILL_POINTS_LEVEL 累计 1/3/7）：按钮每次加 1 点（cd_profile.add_point），卡上经验条 have/need 攒满自动升级（解锁 1 点、一升二 2 点、二升三 4 点）；技能点只能 100 金币买（cd_profile.PRICES.point）。
-- 所有画面节点在代码里按需重建（rebuild）。
local layout = require("shared.layout")
local pill_btn = require("shared.pill_btn")
local coin = require("shared.coin")
local haptic = require("shared.haptic")
local T = require("shared.i18n").t
local C = require("games.clashdoz.cd_config")
local levels = require("games.clashdoz.cd_levels")
local P = require("games.clashdoz.cd_profile")

local WHITE = vmath.vector4(1, 1, 1, 1)
local MUTED = vmath.vector4(0.55, 0.57, 0.7, 1)
local PANEL = vmath.vector4(0.09, 0.11, 0.2, 1)        -- 参考图：深藏青面板
local PANEL_LOCKED = vmath.vector4(0.12, 0.13, 0.18, 1)
local BORDER = vmath.vector4(0.3, 0.4, 0.62, 0.7)      -- 面板描边
local BORDER_CARD = vmath.vector4(0.35, 0.62, 1, 0.9)  -- 点亮的卡：亮蓝框
local BORDER_LOCK = vmath.vector4(0.4, 0.42, 0.5, 0.8) -- 没点亮：灰框
local BORDER_EQ = vmath.vector4(0.45, 1, 0.5, 1)       -- 带进场：绿框
local GOLD = vmath.vector4(1, 0.83, 0.3, 1)
local GREEN = vmath.vector4(0.3, 0.76, 0.32, 1)
local GREEN_LINE = vmath.vector4(0.62, 1, 0.62, 0.9)
local BLUE = vmath.vector4(0.2, 0.5, 0.95, 1)
local BLUE_LINE = vmath.vector4(0.6, 0.82, 1, 0.9)
local GREY = vmath.vector4(0.28, 0.3, 0.38, 1)
local LV_PILL = vmath.vector4(0.16, 0.42, 0.85, 1)
local TRACK = vmath.vector4(0.18, 0.2, 0.3, 1)
local BAR_GREEN = vmath.vector4(0.4, 0.85, 0.3, 1)
local LOCK_TINT = vmath.vector4(0.4, 0.42, 0.5, 1)

-- 版式（root 坐标）
local TOP_Y = 820                       -- 顶栏（金币 / 技能点，与 btn_back 同高）
local COLL_Y, COLL_H = 715, 96          -- Collection 条（紧贴顶栏下面）
local GRID_TOP = 645                    -- 卡牌网格顶边
local COLS, ROWS, GAP_X, GAP_Y = 3, 2, 20, 18   -- 一页 3 列 × 2 行 = 6 张，多了左右滑页（用户 2026-11-04 晚："左右滚动更好"）
local CARD_W, CARD_H = 320, 330
local PAGE_W = 1080
local SLOT_Y, SLOT_W, SLOT_GAP = -300, 200, 240   -- 带进场三个坑：方格（用户 2026-11-04 晚：圆环套圆球太不明显，要有边框像放牌的位置）
local SWIPE_START, SWIPE_PAGE = 14, PAGE_W / 5    -- 拖过 14 px 算拖；松手时拖过 1/5 页就翻
local START_PAD = 110

local S = { visible = false, nodes = {}, hits = {}, sel = nil, confirm = nil }
local CONFIRM_T = 3.0   -- 花币操作要在 3 秒内再点一次才扣

local function v3(x, y) return vmath.vector3(x, y, 0) end
local function root() return gui.get_node("root") end
local function keep(n) S.nodes[#S.nodes + 1] = n; return n end
local function mk_box(parent, x, y, w, h, color, anim)
	local n = gui.new_box_node(v3(x, y), v3(w, h))
	gui.set_parent(n, parent, false)
	if anim then gui.set_texture(n, "clashdoz"); gui.play_flipbook(n, anim) end
	if color then gui.set_color(n, color) end
	return n
end
local function box(parent, x, y, w, h, color, anim) return keep(mk_box(parent, x, y, w, h, color, anim)) end
--- 圆角面板（rr_fill / rr_line，slice9 四边 16）
local function rr(parent, x, y, w, h, color, line)
	local n = box(parent, x, y, w, h, color, line and "rr_line" or "rr_fill")
	gui.set_slice9(n, vmath.vector4(16, 16, 16, 16))
	return n
end
local function mk_text(parent, x, y, s, scale, color, pivot, font)
	local n = gui.new_text_node(v3(x, y), s or "")
	gui.set_parent(n, parent, false); gui.set_font(n, font or "game_font")
	gui.set_scale(n, vmath.vector3(scale or 1, scale or 1, 1)); gui.set_color(n, color or WHITE)
	if pivot then gui.set_pivot(n, pivot) end
	return n
end
local function text(parent, x, y, s, scale, color, pivot, font) return keep(mk_text(parent, x, y, s, scale, color, pivot, font)) end
--- 文字节点显示宽度（像素）
local function text_w(node)
	local ok, m = pcall(function() return resource.get_text_metrics(gui.get_font_resource(gui.get_font(node)), gui.get_text(node)) end)
	return (ok and m and m.width or 0) * gui.get_scale(node).x
end
local function pill(o) local b = pill_btn.new(root(), o); S.pills[#S.pills + 1] = b; return b end
local function hit(node, fn) S.hits[#S.hits + 1] = { node = node, fn = fn } end
local function snd(name, gain) pcall(msg.post, "#snd_" .. name, "play_sound", { gain = gain or 1 }) end

local function clear()
	for _, b in ipairs(S.pills or {}) do b.delete() end
	for _, n in ipairs(S.nodes) do pcall(gui.delete_node, n) end
	S.nodes, S.pills, S.hits = {}, {}, {}
end

--- 花币前的二次确认：第一次点只提示，3 秒内再点同一项才真花
local function confirmed(key)
	local now = socket and socket.gettime and socket.gettime() or os.time()
	if S.confirm and S.confirm.key == key and now - S.confirm.t <= CONFIRM_T then S.confirm = nil; return true end
	S.confirm = { key = key, t = now }
	return false
end

--- 吐司：放在三个坑下面、START 上面（用户 2026-11-04 晚：出现在选牌区看不见）；挂 root，所有调用都在 rebuild 之后所以叠在最上
local function toast(s)
	if S.toast then pcall(gui.delete_node, S.toast) end
	local bg = gui.new_box_node(v3(0, SLOT_Y - SLOT_W / 2 - 62), v3(900, 90)); gui.set_parent(bg, root(), false); gui.set_color(bg, vmath.vector4(0, 0, 0, 0))
	local t = gui.new_text_node(v3(0, 0), s); gui.set_parent(t, bg, false); gui.set_font(t, "game_font"); gui.set_scale(t, vmath.vector3(0.7, 0.7, 1)); gui.set_color(t, GOLD)
	gui.set_line_break(t, true); gui.set_size(t, v3(960 / 0.7, 90))
	gui.animate(bg, "color.w", 0.85, gui.EASING_OUTQUAD, 0.2)
	gui.animate(bg, "color.w", 0, gui.EASING_INQUAD, 0.4, 1.6, function() pcall(gui.delete_node, bg); if S.toast == bg then S.toast = nil end end)
	S.toast = bg
end

local rebuild   -- forward

--- 技能球（用户 2026-10-28 的霓虹球贴图 orb_<id>）；lv 0 = 压暗
local function skill_orb(parent, x, y, d, id, lv)
	return box(parent, x, y, d, d, (lv or 1) > 0 and WHITE or LOCK_TINT, "orb_" .. id)
end

-- ---------------------------------------------------------------- 这局对手的技能：按 seed_base + 关号 的种子随机发（cd_levels.roll），这页不显示（用户 2026-11-04）
local function roll_for(level_num, layout_name)
	local n, plan, mode
	if level_num then local L = levels.get(level_num); n, plan, mode = L.n, levels.plan(level_num), L.mode
	else n, plan = (layout_name == "nine" and 9 or 2), levels.TRIAL_PLAN end
	local seed = (S.seed_base or os.time()) + (level_num or 0) * 101
	local _, enemies = levels.roll(n, plan, seed, P.slots(), mode)
	return enemies, plan.eager, n
end

local function set_level(level_num)
	S.level = level_num
	S.enemies, S.eager, S.n = roll_for(level_num, S.layout)
end

-- ---------------------------------------------------------------- 买技能点（顶栏框内 + 号）：有币直接扣 100 买 1 点（用户 2026-11-04 晚：点加号直接加上，不要确认）
local function buy_point()
	local res = P.buy_point()
	if res == true then snd("pick"); pcall(haptic.success); rebuild()
	elseif res == "no_coins" then toast(T("NOT ENOUGH COINS")) end
end

-- ---------------------------------------------------------------- 顶栏：金币 / 技能点 +
local function build_header()
	local r = root()
	gui.set_text(gui.get_node("level_text"), "")   -- 用户 2026-10-28：这页不显示第几关
	-- 金币
	local cp = rr(r, 150, TOP_Y, 240, 84, PANEL); rr(cp, 0, 0, 240, 84, BORDER, true)
	box(cp, -80, 0, 58, 59, nil, "coin_gold")
	text(cp, -44, 0, tostring(coin.get_balance()), 0.9, vmath.vector4(1, 0.96, 0.85, 1), gui.PIVOT_W)
	-- 技能点 + 框内绿 + 号（用户 2026-11-04 晚：加号要在框里面）
	local sp = rr(r, 400, TOP_Y, 250, 84, PANEL); rr(sp, 0, 0, 250, 84, BORDER, true)
	box(sp, -92, 0, 56, 56, nil, "sp")
	text(sp, -58, 0, tostring(P.points_available()), 0.9, WHITE, gui.PIVOT_W)
	local plus = rr(sp, 86, 0, 60, 60, GREEN); rr(plus, 0, 0, 60, 60, GREEN_LINE, true)
	box(plus, 0, 0, 30, 6, WHITE); box(plus, 0, 0, 6, 30, WHITE)
	hit(plus, buy_point)
end

-- ---------------------------------------------------------------- Collection n / N + 进度条
local function build_collection()
	local r = root()
	local p = rr(r, 0, COLL_Y, 1000, COLL_H, PANEL); rr(p, 0, 0, 1000, COLL_H, BORDER, true)
	local have, total = P.unlocked_count(), #C.SKILL_IDS
	local title = text(p, -470, 0, T("Collection"), 0.78, WHITE, gui.PIVOT_W)
	local tx = -470 + text_w(title) + 28
	local have_t = text(p, tx, 0, tostring(have), 0.66, GOLD, gui.PIVOT_W)   -- 已点亮数金色、总数白色
	text(p, tx + text_w(have_t) + 6, 0, "/ " .. tostring(total), 0.66, WHITE, gui.PIVOT_W)
	local bx0, bw = 120, 350
	rr(p, bx0 + bw / 2, 0, bw, 30, TRACK)
	local fw = bw * have / total
	if fw > 0 then rr(p, bx0 + math.max(32, fw) / 2, 0, math.max(32, fw), 30, BAR_GREEN) end
end

-- ---------------------------------------------------------------- 卡牌网格
--- 卡上的钮：文字 + ⚡ 图标 + 数字，整体居中
local function sp_button(parent, x, y, w, h, color, line, label, cost)
	local b = rr(parent, x, y, w, h, color); rr(b, 0, 0, w, h, line, true)
	if cost then
		local t = text(b, 0, 0, label, 0.46, WHITE, gui.PIVOT_W)
		local n = text(b, 0, 0, tostring(cost), 0.46, WHITE, gui.PIVOT_W)
		local tw, nw, ic, gap = text_w(t), text_w(n), 34, 8
		local total = tw + gap + ic + 4 + nw
		local x0 = -total / 2
		gui.set_position(t, v3(x0, 0)); box(b, x0 + tw + gap + ic / 2, 0, ic, ic, nil, "sp"); gui.set_position(n, v3(x0 + tw + gap + ic + 4, 0))
	else
		text(b, 0, 0, label, 0.46, WHITE)
	end
	return b
end

local function card_tap(id)
	S.sel = id
	if P.level(id) <= 0 then snd("turn", 0.4); rebuild(); return end
	local res = P.toggle(id)
	local say
	if res == "full" then
		if P.slots() < C.SLOTS_MAX then   -- 第 3 位 500 金币开（二次确认），开了直接把这张带上
			if not confirmed("slot") then say = string.format("%s  %d", T("TAP AGAIN TO BUY"), P.PRICES.slot)
			else
				local r2 = P.unlock_slot()
				if r2 == true then P.toggle(id); snd("pick"); pcall(haptic.success) elseif r2 == "no_coins" then say = T("NOT ENOUGH COINS") end
			end
		else
			say = T("Your deck is full. Tap an equipped card to remove it")
		end
	else
		snd("turn", 0.4)
	end
	rebuild()
	if say then toast(say) end
end

local function card_upgrade(id)
	S.sel = id
	-- 用户 2026-11-04 晚：一次加 1 点，卡上经验条攒满才升级（只有 1 点也能点）；解锁 1 点、一升二 2 点、二升三 4 点
	local ok = P.add_point(id)
	if ok then snd("pick"); pcall(haptic.success) end
	rebuild()
	if not ok and P.points_available() < 1 then toast(T("NOT ENOUGH SKILL POINTS")) end
end

local function build_card(parent, id, x, y, w, h)
	local r = parent
	local lv = P.level(id)
	local unlocked = lv > 0
	local eq = unlocked and P.equipped(id)
	local panel = rr(r, x, y, w, h, unlocked and PANEL or PANEL_LOCKED)
	rr(panel, 0, 0, w, h, eq and BORDER_EQ or (unlocked and BORDER_CARD or BORDER_LOCK), true)
	if eq then rr(panel, 0, 0, w + 10, h + 10, vmath.vector4(0.45, 1, 0.5, 0.35), true) end   -- 绿光晕
	local od = math.min(w * 0.42, h * 0.40)
	local oy = h / 2 - 18 - od / 2
	skill_orb(panel, 0, oy, od, id, lv)
	local ny = oy - od / 2 - 22
	local name = text(panel, 0, ny, T(C.def(id).name), 0.5, unlocked and WHITE or MUTED)
	gui.set_line_break(name, true); gui.set_size(name, v3((w - 20) / 0.5, 50))
	if unlocked then   -- 一行：Lv.n 胶囊 + 经验条 have/need（攒满自动升级，用户 2026-11-04 晚）
		local ry = ny - 42
		local lp = rr(panel, -100, ry, 88, 34, LV_PILL); rr(lp, 0, 0, 88, 34, BLUE_LINE, true)
		text(lp, 0, 0, string.format(T("Lv.%d"), lv), 0.36, WHITE)
		local have, need = P.progress(id)
		local bx0, bw = -44, 136
		box(panel, bx0 + bw / 2, ry, bw, 14, TRACK)
		local fw = bw * math.min(1, have / math.max(1, need))
		if fw > 0 then box(panel, bx0 + fw / 2, ry, fw, 14, lv >= C.SKILL_MAX_LEVEL and GOLD or BAR_GREEN) end
		text(panel, bx0 + bw + 8, ry, lv >= C.SKILL_MAX_LEVEL and T("MAX") or (have .. "/" .. need), 0.3, MUTED, gui.PIVOT_W)
	else
		box(panel, 0, ny - 42, 40, 40, LOCK_TINT, "lock")
	end
	local by = -h / 2 + 16 + 31
	local btn
	if not unlocked then btn = sp_button(panel, 0, by, w - 36, 62, BLUE, BLUE_LINE, T("Unlock"), 1)
	elseif lv < C.SKILL_MAX_LEVEL then btn = sp_button(panel, 0, by, w - 36, 62, GREEN, GREEN_LINE, T("Upgrade"), 1)
	else btn = sp_button(panel, 0, by, w - 36, 62, GREY, BORDER, T("MAX")) end
	if eq then   -- 左上角绿勾（右上角让给预览钮）
		local badge = box(panel, -w / 2 + 22, h / 2 - 22, 46, 46, GREEN, "ball")
		box(badge, 0, 0, 30, 30, WHITE, "check")
	end
	-- 右上角 ⓘ 预览钮（用户 2026-11-05 夜：点了到真实小局里完整看这招的动画，可切 1/2/3 级；原先左上角小 ▶ 太小，改成大一号的 information 钮放右上角）；先登记，命中优先于整张卡
	local pv = box(panel, w / 2 - 26, h / 2 - 26, 64, 64, BLUE, "ball"); box(pv, 0, 0, 40, 40, WHITE, "info")
	hit(pv, function() snd("turn", 0.4); msg.post("#controller", "preview_skill", { id = id, level = math.max(1, lv) }) end)
	if lv < C.SKILL_MAX_LEVEL then hit(btn, function() card_upgrade(id) end) end
	hit(panel, function() card_tap(id) end)
end

--- 网格：一页 COLS × ROWS 张，页挨着排在一个可横向拖的容器里（stencil 裁剪框只露本页），底下页点；S.page 当前页
local function build_grid()
	local r = root()
	local ids = C.SKILL_IDS
	local per = COLS * ROWS
	local pages = math.max(1, math.ceil(#ids / per))
	S.pages = pages
	S.page = math.max(0, math.min(pages - 1, S.page or 0))
	local gh = ROWS * CARD_H + (ROWS - 1) * GAP_Y
	local gy = GRID_TOP - gh / 2
	local clip = box(r, 0, gy, PAGE_W, gh + 40, vmath.vector4(0, 0, 0, 0))
	gui.set_clipping_mode(clip, gui.CLIPPING_MODE_STENCIL); gui.set_clipping_visible(clip, false)
	local grid = box(clip, -S.page * PAGE_W, 0, 1, 1, vmath.vector4(0, 0, 0, 0))
	S.grid_node = grid
	local x0 = -(COLS - 1) * (CARD_W + GAP_X) / 2
	for k, id in ipairs(ids) do
		local pg = math.floor((k - 1) / per)
		local kk = (k - 1) % per
		local row, col = math.floor(kk / COLS), kk % COLS
		build_card(grid, id, pg * PAGE_W + x0 + col * (CARD_W + GAP_X), gh / 2 - CARD_H / 2 - row * (CARD_H + GAP_Y), CARD_W, CARD_H)
	end
	if pages > 1 then   -- 页点：当前页白、其余暗；点了直接翻
		local dy = gy - gh / 2 - 36
		for pg = 0, pages - 1 do
			local on = pg == S.page
			local dot = box(r, (pg - (pages - 1) / 2) * 44, dy, on and 22 or 14, on and 22 or 14, on and WHITE or vmath.vector4(0.4, 0.45, 0.6, 1), "ball")
			local hb = box(r, (pg - (pages - 1) / 2) * 44, dy, 44, 44, vmath.vector4(0, 0, 0, 0))
			hit(hb, function() S.page = pg; rebuild() end)
		end
	end
end

-- ---------------------------------------------------------------- 带进场三个坑（用户 2026-11-04 晚二改：方格 + 亮边框，一眼看出是放牌的位置）：
--   带着的卡画球 + 等级角标（绿框）；空坑深底 + 亮蓝双线框 + 中间暗球位；第 3 坑没开：金框 + 锁 + 500（二次确认买）；点带着的坑把那张取下
local function build_slots()
	local r = root()
	local lo, slots = P.loadout_raw(), P.slots()
	local x0 = -(C.SLOTS_MAX - 1) * SLOT_GAP / 2
	for k = 1, C.SLOTS_MAX do
		local x = x0 + (k - 1) * SLOT_GAP
		local c, locked = lo[k], k > slots
		local cell = rr(r, x, SLOT_Y, SLOT_W, SLOT_W, c and PANEL or PANEL_LOCKED)
		local line = locked and vmath.vector4(0.85, 0.68, 0.3, 1) or (c and BORDER_EQ or vmath.vector4(0.45, 0.72, 1, 1))
		rr(cell, 0, 0, SLOT_W, SLOT_W, line, true); rr(cell, 0, 0, SLOT_W - 8, SLOT_W - 8, line, true)   -- 双线 = 粗边框
		if locked then
			box(cell, 0, 16, 56, 56, vmath.vector4(0.75, 0.78, 0.88, 1), "lock")
			box(cell, -30, -46, 34, 35, nil, "coin_gold"); text(cell, -8, -46, tostring(P.PRICES.slot), 0.52, GOLD, gui.PIVOT_W)
			hit(cell, function()
				if not confirmed("slot") then toast(string.format("%s  %d", T("TAP AGAIN TO BUY"), P.PRICES.slot)); return end
				local res = P.unlock_slot()
				if res == true then snd("pick"); pcall(haptic.success); rebuild() elseif res == "no_coins" then toast(T("NOT ENOUGH COINS")) end
			end)
		elseif c then
			skill_orb(cell, 0, 8, SLOT_W * 0.7, c.id, c.level)
			box(cell, 0, -SLOT_W * 0.33, 54, 36, WHITE, "lvl_" .. c.level)
			hit(cell, function() S.sel = c.id; P.toggle(c.id); snd("turn", 0.4); rebuild() end)
		else
			box(cell, 0, 0, SLOT_W * 0.5, SLOT_W * 0.5, vmath.vector4(0.2, 0.26, 0.42, 1), "ring")   -- 空位：暗圈占位
		end
	end
end

-- ---------------------------------------------------------------- 整页
rebuild = function()
	clear()
	if not S.visible then return end
	build_header()
	build_collection()
	build_grid()
	build_slots()
	local bottom = -(960 + layout.extra()) + math.max(layout.safe_bottom(), 40) + START_PAD
	local b = pill({ atlas = "clashdoz", color = "blue", icon = "next", text = T("START"), x = 0, y = bottom, min_w = 460, text_scale = 1.0 })
	hit(b.root, function()
		-- 用户 2026-11-04 晚：一张没选要提醒，至少选两张才能开（只点亮了一张卡的玩家按点亮数算，别把人卡死）
		local lo = P.loadout_raw()
		local need = math.min(C.SLOTS_DEFAULT, P.unlocked_count(), P.slots())
		if P.unlocked_count() == 0 then toast(T("Unlock a card first")); return end
		if #lo < need then toast(string.format(T("Pick %d cards to bring into battle"), need)); return end
		local p = P.load(); p.seen_prep = true; P.save()
		snd("boost")
		msg.post("#controller", "prep_start", { level = S.level, layout = S.layout, loadout = lo, enemies = S.enemies, eager = S.eager })
	end)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	gui.set_render_order(4)
	gui.set_enabled(root(), false)
	layout.fill(gui.get_node("bg"))
	layout.snap_edges({ "btn_back" })
	local extra = layout.extra()
	if extra > 0 or layout.safe_top() > 0 then   -- 出血屏：顶栏贴安全区上移，下面的条和网格跟着让开
		local shift = extra - layout.safe_top() + 28
		for _, id in ipairs({ "btn_back", "level_text" }) do local n = gui.get_node(id); local p = gui.get_position(n); p.y = p.y + shift; gui.set_position(n, p) end
		TOP_Y = TOP_Y + shift
		local half = math.floor(shift / 2)
		COLL_Y, GRID_TOP, SLOT_Y = COLL_Y + half, GRID_TOP + half, SLOT_Y + half
	end
	S.nodes, S.pills, S.hits = {}, {}, {}
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show") then
		S.visible = true
		gui.set_enabled(root(), true)
		msg.post(".", "acquire_input_focus")
		S.layout = message.layout
		S.max_level = message.max_level or 1
		S.seed_base = os.time()
		S.sel, S.confirm, S.page, S.press = nil, nil, 0, nil
		P.load()
		set_level(message.level)
		-- 默认选中带进场的第一张，说明行一进来就有内容
		local lo = P.loadout_raw()
		if lo[1] then S.sel = lo[1].id end
		local ok, err = pcall(rebuild)
		if not ok then print("[clashdoz.prep] rebuild error: " .. tostring(err)) end
	elseif message_id == hash("hide") then
		S.visible = false
		clear()
		gui.set_enabled(root(), false)
	end
end

function final(self) msg.post(".", "release_input_focus") end

function on_input(self, action_id, action)
	if not S.visible then return false end
	if action_id ~= hash("touch") then return false end
	if action.pressed then
		S.press = { x = action.x, y = action.y, drag = false, gx = S.grid_node and gui.get_position(S.grid_node).x or 0 }
		return true
	end
	local pr = S.press
	if pr and not action.released then   -- 按住横向拖：卡牌网格跟手（触点增量按 layout.touch_scale 换算，iPad 横轴不同）
		if S.grid_node then
			local kx = layout.touch_scale()
			local dx = (action.x - pr.x) * kx
			if pr.drag or math.abs(dx) > SWIPE_START then
				pr.drag = true
				local p = gui.get_position(S.grid_node); p.x = pr.gx + dx; gui.set_position(S.grid_node, p)
			end
		end
		return true
	end
	if action.released then
		if pr and pr.drag then   -- 松手：拖过 1/5 页就翻，否则弹回；动画完重建（页点跟着变）
			local kx = layout.touch_scale()
			local dx = (action.x - pr.x) * kx
			local pg = S.page or 0
			if dx < -SWIPE_PAGE then pg = pg + 1 elseif dx > SWIPE_PAGE then pg = pg - 1 end
			S.page = math.max(0, math.min((S.pages or 1) - 1, pg))
			S.press = nil
			if S.grid_node then gui.animate(S.grid_node, gui.PROP_POSITION, v3(-S.page * PAGE_W, 0), gui.EASING_OUTCUBIC, 0.22, 0, function() if S.visible then rebuild() end end) end
			return true
		end
		S.press = nil
		if gui.pick_node(gui.get_node("btn_back"), action.x, action.y) then msg.post("#controller", "back_to_cover"); return true end
		for _, h in ipairs(S.hits) do
			if gui.is_enabled(h.node) and gui.pick_node(h.node, action.x, action.y) then
				local ok, err = pcall(h.fn)
				if not ok then print("[clashdoz.prep] tap error: " .. tostring(err)) end
				return true
			end
		end
	end
	return true   -- 准备页可见时吃掉输入（封面模板铁律）
end

-- 让 tools/i18n_extract.py 看到动态拼出来的键；此函数从不调用
local function _i18n_keys()
	return T("FREEZE"), T("SPLIT"), T("ACCEL"), T("BOMB"), T("GIANT"), T("FIRE"), T("LIGHTNING"), T("TELEPORT"), T("TURRET"), T("CANNON"), T("AMPLIFIER"), T("SOLDIERS"), T("SHATTER"), T("SHOCKWAVE"), T("CHAIN LIGHTNING"), T("PLASMA"),
		   T("TAP AGAIN TO BUY"), T("NOT ENOUGH COINS"), T("START"),
		   T("Collection"), T("Upgrade"), T("Unlock"), T("MAX"), T("Lv.%d"),
		   T("NOT ENOUGH SKILL POINTS"), T("Your deck is full. Tap an equipped card to remove it"), T("Unlock a card first"), T("Pick %d cards to bring into battle")
end
