-- games/clashdoz/clashdoz_cover.gui_script
-- CLASHDOZ 封面：整图底 cover_bg（bigtex，2026-10-28 夜换用户的 Color Battle 竖版整图，源 ~/Projects/PlayDoz_cover_sources/clashdoz_cover_color_battle_v2.png）
--   + PLAY / HOW TO PLAY / BACK TO HOME 三键从屏底往上排；没有动画（展示局代码留在玩法页 start_match{showcase}，封面不触发）。
local game_progress = require("shared.game_progress")
local pill_btn = require("shared.pill_btn")
local bigtex = require("shared.bigtex")
local layout = require("shared.layout")
local T = require("shared.i18n").t

local CONFIG = { game_key = "clashdoz", game_url = "#controller" }
local state = { is_standalone = false }

local function visible() local ok, n = pcall(gui.get_node, "root"); return ok and gui.is_enabled(n) end

function init(self)
    -- 手机：1080×2340 底图；iPad：1440×1920 的 3:4 版按高铺满左右裁边（同 Mahjong，2026-10-20 定式）
    if layout.is_wide() then
        bigtex.apply(gui.get_node("cover_bg"), "/assets/bigtex/clashdoz/cover_bg_ipad.png")
        layout.fit_bg(gui.get_node("cover_bg"), 1440, 1920, 1.0)
    else
        bigtex.apply(gui.get_node("cover_bg"), "/assets/bigtex/clashdoz/cover_bg.png")
    end
    msg.post(".", "acquire_input_focus")
    state.is_standalone = sys.get_config_string("playdoz.mode", "collection") == "standalone"
    gui.set_enabled(gui.get_node("btn_back"), not state.is_standalone)
    -- 三键从屏底往上排（Pupdoku 同款：BACK 底边离屏底 = 安全区 + pad，再往上每 gap 一个；iPad 收紧）
    local wide = layout.is_wide()
    local gap, pad = wide and 185 or 195, wide and 90 or 110   -- 2026-10-28 用户：封面按钮放大（1.15 倍）、间距跟着拉开
    local bottom = -(960 + layout.extra()) + math.max(layout.safe_bottom(), 40) + pad
    local bscale = wide and 1.1 or 1.15
    for _, id in ipairs({ "btn_play", "btn_howtoplay", "btn_back" }) do gui.set_scale(gui.get_node(id), vmath.vector3(bscale, bscale, 1)) end
    gui.set_position(gui.get_node("btn_back"), vmath.vector3(0, bottom, 0))
    gui.set_position(gui.get_node("btn_howtoplay"), vmath.vector3(0, bottom + gap, 0))
    gui.set_position(gui.get_node("btn_play"), vmath.vector3(0, bottom + 2 * gap, 0))
    pill_btn.label(gui.get_node("btn_play"), { text = T("PLAY"), color = "orange" })
    pill_btn.label(gui.get_node("btn_howtoplay"), { text = T("HOW TO PLAY"), color = "green" })
    pill_btn.label(gui.get_node("btn_back"), { text = T("BACK TO HOME"), color = "purple" })
    -- 2026-10-28 用户：1 VS 1 / 1 VS 8 / TEST LAB 三颗试玩胶囊去掉，只剩 PLAY 一关关来（试验场留 debug 深链 level=79 给冒烟）
    -- 2026-10-28 夜 用户：封面直接用整张 Color Battle 竖版图（手机按高铺满裁两边、iPad 按宽铺满裁上下），不再放动画（玩法页的展示模式代码保留，不触发）
end

function on_message(self, message_id, message, sender)
    if message_id == hash("hide") then
        gui.set_enabled(gui.get_node("root"), false)
    elseif message_id == hash("show") then
        gui.set_enabled(gui.get_node("root"), true)
    elseif message_id == hash("coming_soon") then
        -- 关卡打完：屏幕中央奶白胶囊 + 大号加粗黑字（两层错位 3px 叠粗），2.5s 后淡出自删（Mahjong 同款）
        if self.toast then pcall(gui.delete_node, self.toast) end
        local bg = gui.new_box_node(vmath.vector3(0, 40, 0), vmath.vector3(1000, 200, 0))
        gui.set_color(bg, vmath.vector4(1, 0.97, 0.9, 0)); gui.set_parent(bg, gui.get_node("root")); self.toast = bg
        for _, off in ipairs({ { 3, 0 }, { 0, 0 } }) do
            local t = gui.new_text_node(vmath.vector3(off[1], off[2], 0), T("MORE LEVELS COMING SOON!"))
            gui.set_font(t, "game_font"); gui.set_color(t, vmath.vector4(0.05, 0.05, 0.08, 1)); gui.set_scale(t, vmath.vector3(1.55, 1.55, 1)); gui.set_parent(t, bg)
        end
        gui.animate(bg, "color.w", 0.94, gui.EASING_OUTQUAD, 0.25)
        gui.animate(bg, "color.w", 0, gui.EASING_INQUAD, 0.5, 2.5, function() pcall(gui.delete_node, bg); if self.toast == bg then self.toast = nil end end)
    end
end

function on_input(self, action_id, action)
    if not visible() then return false end
    if action_id ~= hash("touch") or not action.released then return false end
    if not state.is_standalone and gui.pick_node(gui.get_node("btn_back"), action.x, action.y) then
        msg.post("main:/main#script", "unload_game")
        return true
    end
    if gui.pick_node(gui.get_node("btn_howtoplay"), action.x, action.y) then
        msg.post(CONFIG.game_url, "start_demo")
        return true
    end
    if gui.pick_node(gui.get_node("btn_play"), action.x, action.y) then
        msg.post(CONFIG.game_url, "start_game", {})   -- 关号由 controller 取进度决定（2026-10-27：十关全过停在第 10 关准备页，不再 coming_soon）
        return true
    end
    return false
end

function final(self)
    msg.post(".", "release_input_focus")
end
